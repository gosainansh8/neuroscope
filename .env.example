DATABASE_URL=postgresql://postgres:postgres@localhost:5432/neuroscope
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/neuroscope_test
# Vertex AI embeddings (optional; only for `neuroscope.embed` and `search --semantic`).
# Sign in first with: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Agent model (optional overrides; these are the defaults)
# NEUROSCOPE_AGENT_MODEL=gemini-3.8-flash
# NEUROSCOPE_AGENT_LOCATION=global

# Company disclosures (SEC EDGAR): the SEC asks automated clients for a contact, sent to sec.gov only.
SEC_USER_AGENT="NeuroScope research you@example.com"
